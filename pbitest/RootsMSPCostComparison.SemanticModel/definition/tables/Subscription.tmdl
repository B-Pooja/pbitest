table Subscription
	lineageTag: 5f81b557-4af8-44b7-a1bd-26dbe789f466

	measure 'Avg cost Week' = AVERAGEX(VALUES('Subscription'[WeekNumber]),CALCULATE(SUM('Subscription'[CostUSD])))
		formatString: \$#,0.###############;(\$#,0.###############);\$#,0.###############
		lineageTag: d52065b8-d8e9-4125-aa88-206fc96334ff

	measure 'Avg cost Month' = AVERAGEX(VALUES('Subscription'[Month]),CALCULATE(SUM('Subscription'[CostUSD])))
		formatString: \$#,0.00;(\$#,0.00);\$#,0.00
		lineageTag: ebaaa3cb-bea2-4193-b167-3b11b14bf4a4

	measure 'Avg cost Year' = AVERAGEX(VALUES('Subscription'[Year]),CALCULATE(SUM('Subscription'[CostUSD])))
		formatString: \$#,0.00;(\$#,0.00);\$#,0.00
		lineageTag: 28e40a8e-588d-466d-9305-c60ab8274df9

