	column MonthNumber = ```
			SWITCH(
			    TRUE(),
			    'Subscription'[Month] = "January", 1,
			    'Subscription'[Month] = "February", 2,
			    'Subscription'[Month] = "March", 3,
			    'Subscription'[Month] = "April", 4,
			    'Subscription'[Month] = "May", 5,
			    'Subscription'[Month] = "June", 6,
			    'Subscription'[Month] = "July", 7,
			    'Subscription'[Month] = "August", 8,
			    BLANK()
			)
			
			```
		formatString: 0
