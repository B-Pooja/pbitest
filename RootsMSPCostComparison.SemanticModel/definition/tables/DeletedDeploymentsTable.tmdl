	column Column21
		lineageTag: b0e035fe-3751-41dc-bfa1-c3d5929765c0
		summarizeBy: none
		isNameInferred
		sourceColumn: Subscription[Column21]

		annotation SummarizationSetBy = Automatic

	partition DeletedDeploymentsTable = calculated
		mode: import
		source = ```
				
				VAR CurrentWeek = MAX(Subscription[WeekNum])
				VAR PreviousWeek = CurrentWeek - 1
				
				VAR CurrentWeekResources = 
				    SELECTCOLUMNS(
				        FILTER(Subscription, Subscription[WeekNum] = CurrentWeek),
				        "ResourceName", Subscription[Resource Name]
				    )
				
				RETURN
				FILTER(
				    Subscription,
				    Subscription[WeekNum] = PreviousWeek &&
				    NOT (
				        Subscription[Resource Name] IN CurrentWeekResources
				    )
				)
				
				```

	annotation PBI_Id = 3bef83ccf9f3487197ebddac28f535c5

