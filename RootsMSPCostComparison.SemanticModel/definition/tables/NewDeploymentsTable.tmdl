	column Column21
		lineageTag: fc2e2864-48d4-4275-a3d1-b7fdb406b39b
		summarizeBy: none
		isNameInferred
		sourceColumn: Subscription[Column21]

		annotation SummarizationSetBy = Automatic

	partition NewDeploymentsTable = calculated
		mode: import
		source = ```
				
				VAR CurrentWeek = MAX(Subscription[WeekNum])
				VAR PreviousWeek = CurrentWeek - 1
				
				VAR PreviousWeekResources = 
				    SELECTCOLUMNS(
				        FILTER(Subscription, Subscription[WeekNum] = PreviousWeek),
				        "ResourceName", Subscription[Resource Name]
				    )
				
				RETURN
				FILTER(
				    Subscription,
				    Subscription[WeekNum] = CurrentWeek &&
				    NOT (
				        Subscription[Resource Name] IN PreviousWeekResources
				    )
				)
				
				```

	annotation PBI_Id = 674126be4f924c33b8e5a71ce84a4f78

